{
  "name": "eve-ambient-attention",
  "main": "index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "ATTENTION", "class_name": "AttentionCell" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AttentionCell"] }],
  "vars": {
    "CELLD_FLEET_URL": "https://attention.example.internal",
    "ATTENTION_PREPARE_URL": "https://app.example.internal/ambient/prepare",
    "ATTENTION_DELIVER_URL": "https://app.example.internal/ambient/deliver",
    "ATTENTION_SECRET": "replace-from-secret-store",
    "ATTENTION_MAX_BRANCHES": "1000",
    "ATTENTION_MAX_FANOUT_BYTES": "16777216",
    "ATTENTION_MAX_PREPARED_WAKE_BYTES": "1048576",
    "ATTENTION_MAX_RESIDENT_BYTES": "33554432",
    "ATTENTION_DEDUPE_MS": "604800000",
    "ATTENTION_RETRY_DELAY_MS": "1000",
    "ATTENTION_CLAIM_LEASE_MS": "30000",
    "ATTENTION_MAX_ATTEMPTS": "10"
  }
}
