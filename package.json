{
  "name": "eve-ambient-workspace",
  "version": "0.6.0",
  "private": true,
  "description": "Workspace for Eve Ambient packages, adapters, and examples.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run check:eve-patch && pnpm run pack:check && pnpm run check:consumer",
    "check:consumer": "node scripts/check-clean-consumer.mjs",
    "check:eve-patch": "node scripts/check-eve-patch.mjs",
    "clean": "pnpm --recursive --if-present run clean",
    "pack:check": "node scripts/check-package-artifacts.mjs",
    "pack:release": "node scripts/pack-release-artifacts.mjs",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
  "engines": {
    "node": ">=24"
  }
}
