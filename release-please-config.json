{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "dfb4b4f33cfc855b72cc3e9524265de5a235e6c4",
  "draft": true,
  "force-tag-creation": true,
  "group-pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "packages": {
    ".": {
      "bump-minor-pre-major": true,
      "changelog-path": "packages/ambient/CHANGELOG.md",
      "component": "eve-ambient",
      "exclude-paths": [
        "examples/world-attention",
        "examples/slack-sequence",
        "integration/eve-conformance",
        "integration/attention-world",
        "integration/workflow-correlation",
        "packages/eve-adapter"
      ],
      "extra-files": [
        {
          "jsonpath": "$.version",
          "path": "packages/ambient/package.json",
          "type": "json"
        }
      ],
      "include-component-in-tag": false,
      "package-name": "@ewhauser/eve-ambient",
      "release-type": "node"
    },
    "packages/eve-adapter": {
      "component": "eve-ambient-eve",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "package-name": "@ewhauser/eve-ambient-eve",
      "release-type": "node"
    }
  }
}
