diff --git i/packages/eve/src/channel/channel-address.test.ts w/packages/eve/src/channel/channel-address.test.ts
index 6ed63f5..6e3d838 100644
--- i/packages/eve/src/channel/channel-address.test.ts
+++ w/packages/eve/src/channel/channel-address.test.ts
@@ -58,0 +59,47 @@ describe("createChannelAddress", () => {
+  it("carries one explicit idempotency key through existing and initial sessions", async () => {
+    const existingRuntime = createRuntime();
+    const existingAddress = createChannelAddress({
+      adapter: { kind: "slack" },
+      channelName: "slack",
+      continuationToken: "C1:T1",
+      runtime: existingRuntime,
+    });
+
+    await existingAddress.send("hello", {
+      auth: null,
+      idempotencyKey: "eve:wake:v1:wake-1",
+    });
+
+    expect(existingRuntime.dispatchContinuation).toHaveBeenCalledWith({
+      command: expect.objectContaining({
+        taskDeliveryId: "eve:wake:v1:wake-1",
+      }),
+      continuationToken: "slack:C1:T1",
+    });
+
+    const initialRuntime = createRuntime();
+    vi.mocked(initialRuntime.dispatchContinuation).mockResolvedValue({
+      status: "session_not_active",
+    });
+    vi.mocked(initialRuntime.createSession).mockResolvedValue({
+      sessionId: "sess_2",
+    } as never);
+    const initialAddress = createChannelAddress({
+      adapter: { kind: "slack" },
+      channelName: "slack",
+      continuationToken: "C1:T2",
+      runtime: initialRuntime,
+    });
+
+    await initialAddress.send("hello", {
+      auth: null,
+      idempotencyKey: "eve:wake:v1:wake-2",
+    });
+
+    expect(initialRuntime.createSession).toHaveBeenCalledWith(
+      expect.objectContaining({
+        idempotencyKey: "eve:wake:v1:wake-2",
+      }),
+    );
+  });
+
