{
  "name": "@ewhauser/eve-ambient",
  "version": "0.3.0",
  "description": "Durable typed event monitors and ambient attention for Eve agents.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "pack:check": "node scripts/check-package-artifact.mjs",
    "pack:release": "node scripts/pack-release-artifact.mjs",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "ai": "^7.0.38",
    "pg": "^8.16.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "ai": "^7.0.38",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-ambient.git"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-ambient/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-ambient#readme",
  "dependencies": {
    "xstate": "^5.20.0"
  }
}
