{
  "name": "@ewhauser/eve-ambient",
  "version": "0.4.0",
  "description": "Durable ambient attention engine for typed channel events.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "migrations",
    "celld-worker",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "eve-ambient": "bin/eve-ambient.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./celld": {
      "types": "./dist/celld.d.ts",
      "import": "./dist/celld.js",
      "default": "./dist/celld.js"
    },
    "./celld-worker": {
      "types": "./dist/celld-worker.d.ts",
      "import": "./dist/celld-worker.js",
      "default": "./dist/celld-worker.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency.d.ts",
      "import": "./dist/idempotency.js",
      "default": "./dist/idempotency.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check:celld-worker": "node celld-worker/build.mjs && node -e \"fs.rmSync('celld-worker/build', { recursive: true, force: true })\"",
    "clean": "node -e \"for (const path of ['dist', 'celld-worker/build']) fs.rmSync(path, { recursive: true, force: true })\"",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2",
    "pg": "^8.16.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-ambient.git",
    "directory": "packages/ambient"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-ambient/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-ambient#readme"
}
